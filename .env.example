# ==============================================================================
# Google Cloud & Gemini Decisions API Configuration (No Fallbacks)
# ==============================================================================

# Gemini Decisions API (System 1 - Fast, Calibrated Closed-Set Decisions)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/api-keys
# In Cloud Run, mount securely from Secret Manager: --set-secrets="GEMINI_API_KEY=gemini-api-key:latest"
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DECISION_MODEL=gemini-decision-1

# Google Cloud Gemini Enterprise Agent Platform (System 2 - Deep Reasoning via Keyless IAM ADC)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Routing Policy
# Requests with calibrated confidence >= CONFIDENCE_THRESHOLD and P(can_auto_resolve) >= 0.80
# execute on the System 1 Fast Path; ambiguous or complex incidents escalate to System 2.
CONFIDENCE_THRESHOLD=0.85

# Optional BigQuery Telemetry Sink
ENABLE_BIGQUERY_TELEMETRY=false
BIGQUERY_DATASET=decisions_gateway_telemetry
BIGQUERY_TABLE=decision_events

# Local Development Server Settings (127.0.0.1 for local testing; 0.0.0.0 inside containers)
HOST=127.0.0.1
PORT=8080
